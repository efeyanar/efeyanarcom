---
const currentLang = Astro.currentLocale || "tr";
const targetLang = currentLang === "tr" ? "en" : "tr";
const targetPath = currentLang === "tr" ? "/en" : "/";
---

<a
  href={targetPath}
  class="w-10 h-10 flex items-center justify-center border border-current rounded-full text-[10px] font-black uppercase tracking-wider hover:opacity-70 active:scale-90 transition-all duration-300 cursor-pointer shrink-0"
  aria-label="Dil Değiştir"
>
  {targetLang}
</a>