---
import { Sun, Moon } from 'lucide-astro';
---

<button
  id="theme-toggle"
  class="relative w-10 h-10 flex items-center justify-center border border-current rounded-full hover:opacity-70 active:scale-90 transition-all duration-300 cursor-pointer overflow-hidden"
  aria-label="Tema Değiştir"
>
  <div class="sun-icon absolute flex items-center justify-center transition-all duration-500 ease-out">
    <Sun class="w-4 h-4" />
  </div>

  <div class="moon-icon absolute flex items-center justify-center transition-all duration-500 ease-out">
    <Moon class="w-4 h-4" />
  </div>
</button>

<script>
  const toggleBtn = document.getElementById('theme-toggle');
  toggleBtn?.addEventListener('click', () => {
    const element = document.documentElement;
    element.classList.toggle('dark');
    const isDark = element.classList.contains('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });
</script>

<style>
  .sun-icon {
    opacity: 0;
    transform: rotate(-90deg) scale(0);
  }
  .moon-icon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  :global(.dark) .sun-icon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
  
  :global(.dark) .moon-icon {
    opacity: 0;
    transform: rotate(90deg) scale(0);
  }
</style>